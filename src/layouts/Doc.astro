---
import '../styles.css';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  locale: 'fr' | 'en';
}
const { title, locale } = Astro.props;
const siteTitle = 'Why';
const langLabel = locale === 'fr' ? 'Français' : 'English';
const dlUrl = locale === 'fr' ? '/fr/telechargement' : '/en/download';
const dlLabel = locale === 'fr' ? 'Téléchargement' : 'Download';
const norm = (id: string) => id.replace(/\/index(\.md)?$/, '').replace(/\.md$/, '');
const name = (id: string) => norm(id).slice(locale.length + 1);
const urlOf = (id: string) => `/${locale}/${name(id)}`;

const all = (await getCollection('docs')).filter((d) => norm(d.id).startsWith(`${locale}/`));

const topLevel = all
  .filter((d) => norm(d.id).split('/').length === 2 && name(d.id) !== 'index')
  .sort((a, b) => a.data.weight - b.data.weight);

const refChildren = topLevel.filter((d) => name(d.id).startsWith('ref-'));
const sections = topLevel.filter((d) => !name(d.id).startsWith('ref-'));

const nav = sections.map((s) => {
  const item = { title: s.data.title, url: urlOf(s.id), children: [] as { title: string; url: string }[] };
  if (name(s.id) === 'ref') {
    item.children = refChildren.map((c) => ({ title: c.data.title, url: urlOf(c.id) }));
  }
  return item;
});

const cur = Astro.url.pathname.replace(/\/$/, '');
const active = (u: string) => cur === u || cur.startsWith(u + '/');
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === siteTitle ? siteTitle : `${title} · ${siteTitle}`}</title>
    <meta name="description" content="Why — langage, spec, référence et performance." />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#161514" />
    <script is:inline>
      // Thème : applique la préférence sauvegardée avant le premier rendu (évite le flash).
      // « auto » (pas d'attribut) suit prefers-color-scheme via le CSS.
      (function () {
        try {
          var t = localStorage.getItem('why-theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="top">
      <a class="brand" href={`/${locale}/`}>{siteTitle}</a>
      <div class="top-actions">
        <a class="play" href="https://play.why.noematic.eu">
          {locale === 'fr' ? 'Essayer le tour' : 'Try the tour'}
        </a>
        <a class="defi" href="https://defi.why.noematic.eu">
          {locale === 'fr' ? 'Les défis' : 'Challenges'}
        </a>
        <a class="paper" href={`/paper/why-overview-${locale}.pdf`} download>
          {locale === 'fr' ? '📄 Papier (PDF)' : '📄 Paper (PDF)'}
        </a>
        <a class="dl" href={dlUrl}>
          {locale === 'fr' ? '⬇ Télécharger' : '⬇ Download'}
        </a>
        <button id="theme-toggle" class="theme" type="button" aria-label="Thème">
          <span class="theme-ico" aria-hidden="true"></span>
        </button>
        <nav class="lang" aria-label="langue">
          <a href="/fr/" class={locale === 'fr' ? 'on' : ''}>Français</a>
          <a href="/en/" class={locale === 'en' ? 'on' : ''}>English</a>
        </nav>
      </div>
    </header>
    <div class="wrap">
      <aside class="nav">
        <ul>
          <li class="dl-item"><a href={dlUrl} class={active(dlUrl) ? 'on' : ''}>⬇ {dlLabel}</a></li>
          {nav.map((item) => (
            <>
              <li><a href={item.url} class={active(item.url) ? 'on' : ''}>{item.title}</a></li>
              {item.children.map((c) => (
                <li class="sub"><a href={c.url} class={active(c.url) ? 'on' : ''}>{c.title}</a></li>
              ))}
            </>
          ))}
        </ul>
      </aside>
      <main class="content">
        <slot />
      </main>
    </div>
    <footer class="foot">
      <span>{siteTitle} — <a href={`/${locale}/`}>{langLabel}</a></span>
      <span class="sep" aria-hidden="true">·</span>
      <a href="mailto:contact@noematic.eu">contact@noematic.eu</a>
    </footer>
    <script is:inline>
      // Bascule du thème : auto → clair → sombre. La préférence est mémorisée
      // (localStorage « why-theme ») ; « auto » suit le système via le CSS.
      (function () {
        var KEY = 'why-theme';
        var ORDER = ['auto', 'light', 'dark'];
        var root = document.documentElement;
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        var fr = root.getAttribute('lang') === 'fr';
        var LABELS = fr
          ? { auto: 'Thème : automatique (suit le système)', light: 'Thème : clair', dark: 'Thème : sombre' }
          : { auto: 'Theme: auto (follows the system)', light: 'Theme: light', dark: 'Theme: dark' };
        var ICONS = {
          auto: '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>',
          light: '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/></svg>',
          dark: '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>'
        };
        function current() {
          var s = null;
          try { s = localStorage.getItem(KEY); } catch (e) {}
          return ORDER.indexOf(s) !== -1 ? s : 'auto';
        }
        function render() {
          var t = current();
          if (t === 'auto') root.removeAttribute('data-theme');
          else root.setAttribute('data-theme', t);
          var ico = btn.querySelector('.theme-ico');
          if (ico) ico.innerHTML = ICONS[t];
          btn.setAttribute('aria-label', LABELS[t]);
          btn.setAttribute('title', LABELS[t]);
        }
        btn.addEventListener('click', function () {
          var next = ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length];
          try {
            if (next === 'auto') localStorage.removeItem(KEY);
            else localStorage.setItem(KEY, next);
          } catch (e) {}
          render();
        });
        render();
      })();
    </script>
  </body>
</html>
